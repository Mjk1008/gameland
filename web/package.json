{
  "name": "gameland-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "setup": "node scripts/setup-dev.mjs",
    "local:prod:sync": "node scripts/local-prod.mjs",
    "local:prod:sync:sms": "node scripts/local-prod.mjs --with-sms",
    "local:prod": "npm run build && next start -p 3000",
    "local:prod:dev": "npm run local:prod:sync && npm run dev",
    "deploy": "liara deploy --app gameland --detach",
    "deploy:logs": "liara deploy --app gameland",
    "env:prod": "liara env ls --app gameland",
    "db:init": "psql \"$DATABASE_URL\" -f lib/db/init.sql",
    "ranking:demo": "npx tsx scripts/demo-ranking.ts",
    "icons": "node scripts/gen-icons.mjs",
    "arena:seed": "curl -s -X POST http://localhost:3000/api/arena/seed",
    "assistant:eval": "npx tsx scripts/assistant-eval.ts",
    "rehearsal:preflight": "node scripts/rehearsal/preflight.mjs",
    "rehearsal:clone": "node scripts/rehearsal/clone.mjs",
    "rehearsal:reset": "node scripts/rehearsal/reset-brackets.mjs",
    "rehearsal:deploy": "node scripts/rehearsal/deploy.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "bcryptjs": "2.4.3",
    "drizzle-orm": "0.36.4",
    "https-proxy-agent": "^9.1.0",
    "next": "14.2.33",
    "next-auth": "4.24.10",
    "nodemailer": "^6.10.1",
    "postgres": "3.4.5",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "2.4.6",
    "@types/node": "20.16.10",
    "@types/react": "18.3.11",
    "@types/react-dom": "18.3.0",
    "autoprefixer": "10.4.20",
    "postcss": "8.4.47",
    "tailwindcss": "3.4.13",
    "tsx": "4.19.1",
    "typescript": "5.6.2"
  }
}
