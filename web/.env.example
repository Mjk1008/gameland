# ─────────────────────────────────────────────────────────────────────────────
# Gameland — environment variables template
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local
#
# PRIMARY:   Liara (Iran) — set AUTH_PROVIDER=nextauth
# SECONDARY: Supabase (international) — set AUTH_PROVIDER=supabase
# Full guide: ../docs/16-infrastructure.md
# ─────────────────────────────────────────────────────────────────────────────

# ── Database (required) ───────────────────────────────────────────────────────
# Liara:    postgresql://USER:PASS@HOST.liara.ir:5432/gameland
# Supabase: postgresql://postgres:PASS@db.XXXX.supabase.co:5432/postgres
DATABASE_URL=

# ── Auth provider (required) ──────────────────────────────────────────────────
# "nextauth" = Liara path   |   "supabase" = Supabase path
AUTH_PROVIDER=nextauth

# NextAuth (used when AUTH_PROVIDER=nextauth)
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=

# Google OAuth (primary sign-in). Create at console.cloud.google.com →
# APIs & Services → Credentials → OAuth client ID (Web application).
# Authorized redirect URI: <NEXTAUTH_URL>/api/auth/callback/google
# When both are empty, the Google button is hidden and phone-OTP is used.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Admin allow-list: Google emails that get role=admin on sign-in (comma-separated)
ADMIN_EMAILS=

# Supabase Auth (used when AUTH_PROVIDER=supabase)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── App URL ───────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── SMS — Kavenegar (same for both providers) ─────────────────────────────────
KAVENEGAR_API_KEY=
KAVENEGAR_SENDER=

# ── Object storage ────────────────────────────────────────────────────────────
# Liara S3-compatible storage
LIARA_STORAGE_ENDPOINT=
LIARA_STORAGE_ACCESS_KEY=
LIARA_STORAGE_SECRET_KEY=
LIARA_STORAGE_BUCKET=gameland
