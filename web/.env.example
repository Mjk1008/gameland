# ─────────────────────────────────────────────────────────────────────────────
# Gameland — environment variables template
# Copy to .env.local for local dev:  cp .env.example .env.local
# Or run:  npm run setup
# NEVER commit .env.local
#
# Production (Liara):  liara env ls --app gameland
# Full guide: ../docs/16-infrastructure.md
# ─────────────────────────────────────────────────────────────────────────────

# ── Database ──────────────────────────────────────────────────────────────────
# Leave empty for in-memory dev (OTP=123456, data resets on restart).
# Liara:    postgresql://USER:PASS@HOST.liara.cloud:PORT/postgres
# Supabase: postgresql://postgres:PASS@db.XXXX.supabase.co:5432/postgres
DATABASE_URL=

# ── Auth ──────────────────────────────────────────────────────────────────────
AUTH_PROVIDER=nextauth

NEXTAUTH_URL=http://localhost:3000
# Generate: openssl rand -base64 32
NEXTAUTH_SECRET=

# Google OAuth — blocked from Iran-hosted servers unless proxied.
# Local: keep GOOGLE_OAUTH_ENABLED unset/false → phone OTP login.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_ENABLED=false
# Outbound proxy for Google token exchange from Liara (optional)
OAUTH_PROXY_URL=

# Admin allow-lists (comma-separated)
ADMIN_EMAILS=
ADMIN_PHONES=

# Supabase Auth (only when AUTH_PROVIDER=supabase)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── App ───────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── SMS — Kavenegar ───────────────────────────────────────────────────────────
KAVENEGAR_API_KEY=
KAVENEGAR_SENDER=
KAVENEGAR_OTP_TEMPLATE=gameland-otp

# ── Email — Liara Mail / SMTP ─────────────────────────────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=گیم‌لند <no-reply@gamelandteam.ir>

# ── Object storage (Liara S3-compatible) ──────────────────────────────────────
LIARA_STORAGE_ENDPOINT=
LIARA_STORAGE_ACCESS_KEY=
LIARA_STORAGE_SECRET_KEY=
LIARA_STORAGE_BUCKET=gameland

# ── Feature flags / misc ──────────────────────────────────────────────────────
# Play Arena («میدون») — OFF on Liara until you flip it after local QA
ARENA_ENABLED=false
NEXT_PUBLIC_ARENA_ENABLED=false
# Local dev: set both to true in .env.local
# Force re-seed demo gamers + requests (development only)
# ARENA_SEED=force
# Comma-separated phones shown on honor/arcade screens (optional)
HONOR_USER_PHONE=
