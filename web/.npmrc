# Liara build runs from Iran — registry.npmjs.org is unreachable there.
# Liara injects its own mirror as the registry. These settings keep the
# install from ever reaching out to npmjs.org (the audit/fund phases do),
# which is what was hanging the build for ~20 min.
audit=false
fund=false
prefer-offline=true
fetch-retries=5
fetch-retry-mintimeout=20000
fetch-retry-maxtimeout=120000
fetch-timeout=600000
